{% extends '@BaseAdmin/layouts/cork/bundles/FOSUserBundle/layout.html.twig' %}

{% set action = path("fos_user_security_check") %}
{% set csrf_token_intention = 'authenticate' %}
{% set forgot_password_enabled = true %}
{% set forgot_password_path = path("fos_user_resetting_request") %}

{% block page_title %}{{"title.security.login"|trans}}{% endblock page_title %}
{% block page_title_info %}{{"title.security.login"|trans}}{% endblock page_title_info %}
{% block page_sub_title_info %}{{"title.security.login.info"|trans}}{% endblock page_sub_title_info %}

{% block fos_user_content %}
	{% include('@BaseAdmin/layouts/cork/bundles/FOSUserBundle/Security/login_content.html.twig') %}
	<script>
		console.log("Hola")
		document.addEventListener('DOMContentLoaded', function() {
			const togglePassword = document.getElementById('toggle-password');
			const passwordField = document.getElementById('password');
			
			if (togglePassword && passwordField) {
				togglePassword.addEventListener('click', function() {
					const isPassword = passwordField.getAttribute('type') === 'password';
					passwordField.setAttribute('type', isPassword ? 'text' : 'password');
					
					// Cambiar el icono visualmente
					if (isPassword) {
						this.innerHTML = `
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye-off">
								<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
								<line x1="1" y1="1" x2="23" y2="23"></line>
							</svg>`;
					} else {
						this.innerHTML = `
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye">
								<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
								<circle cx="12" cy="12" r="3"></circle>
							</svg>`;
					}
				});
			}
		});
	</script>
{% endblock fos_user_content %}